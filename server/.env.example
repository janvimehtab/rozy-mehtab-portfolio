# ===================================================
# 1. Server Runtime Configuration
# ===================================================
# Port is automatically injected by Render (leave empty on Render or set to 5000 locally)
PORT=5000
NODE_ENV=production

# Frontend URL(s) for CORS & redirect links (comma-separated if multiple, e.g. custom domain + render URL)
# Example: https://rozymehtabofficial.com,https://rozymehtab.onrender.com
CLIENT_URL=http://localhost:5173

# Public Backend URL for host email approve/decline links
# Render automatically injects RENDER_EXTERNAL_URL, but you can explicitly specify SERVER_URL if using a custom domain
# Example: https://rozymehtab-api.onrender.com
SERVER_URL=http://localhost:5000

# ===================================================
# 2. Database Connection (CRITICAL REQUIRED IN PRODUCTION)
# ===================================================
# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/career_guidance?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/career_guidance?retryWrites=true&w=majority

# ===================================================
# 3. Security & Cryptographic Signing (CRITICAL REQUIRED)
# ===================================================
# 64-char random hex string used to sign single-use email approval/decline tokens
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTION_TOKEN_SECRET=replace_with_a_secure_random_64_char_hex_secret

# Host email where booking notifications and approval action buttons will be sent
HOST_EMAIL=rozymehtab@gmail.com

# ===================================================
# 4. Google Calendar API (Service Account - Optional / Recommended)
# ===================================================
# Enables real-time Free/Busy calendar slot query and Google Meet link generation
GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-calendar-bot@your-gcp-project.iam.gserviceaccount.com
# Paste private key with \n preserved or wrapped in quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary

# ===================================================
# 5. Resend Email API (HTTPS Port 443 - Recommended for Render)
# ===================================================
# Eliminates direct SMTP port (587/465) cloud timeout blocks on Render
# Obtain API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Default verified sender: Rozy Mehtab Guidance <onboarding@resend.dev> or your custom verified domain
EMAIL_FROM="Rozy Mehtab Guidance <onboarding@resend.dev>"

